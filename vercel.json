{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["arn1"],
  "functions": {
    "api/graphql.ts": { "maxDuration": 60 }
  },
  "redirects": [
    { "source": "/graphql", "destination": "/api/graphql", "permanent": true },
    {
      "source": "/playground",
      "destination": "/api/graphql",
      "permanent": true
    },
    { "source": "/sdl", "destination": "/api/sdl", "permanent": true }
  ]
}
